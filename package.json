{
	"name": "ui-text-editor",
	"version": "0.1.1",
	"private": true,
	"description": "Rich Text Editor for Desk",
	"license": "MIT",
	"author": "Avunu LLC",
	"type": "module",
	"scripts": {
		"dev": "vite build --mode development && node scripts/vite-register.mjs && vite build --mode development --watch",
		"build": "vite build && node scripts/vite-register.mjs",
		"build:bundle": "vite build",
		"typecheck": "tsc --build tsconfig.solution.json && node scripts/vue-tsc.cjs --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"upgrade": "npx npm-check-updates -u && yarn install",
		"check:scope": "node build/check-scope.mjs",
		"test": "node --test \"build/**/*.test.ts\"",
		"lint:py": "uv run --frozen --project tools ruff check . && uv run --frozen --project tools ruff format --check .",
		"typecheck:py": "uv run --frozen --project tools ty check --python \"${FRAPPE_BENCH_ROOT:-.frappe-nix/bench}/env\"",
		"check": "yarn -s format:check && yarn -s lint && yarn -s typecheck",
		"ci:typecheck": "yarn -s test && yarn -s build:bundle && yarn -s check:scope"
	},
	"dependencies": {
		"@iconify-json/lucide": "^1",
		"frappe-ui": "^1.0",
		"vue": "^3",
		"vue-router": "^5.4.0"
	},
	"devDependencies": {
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-code-block": "^3.32.0",
		"@tiptap/extension-list": "^3.32.0",
		"@tiptap/extension-underline": "^3.32.0",
		"@types/node": "^26.6.5",
		"@vitejs/plugin-vue": "^6.0.10",
		"frappe-types": "^16.5.0",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"postcss": "^8.5.31",
		"postcss-prefix-selector": "^2.2.1",
		"tailwindcss": "^3.4.17",
		"typescript": "^7.0.2",
		"typescript5": "npm:typescript@^5.9.3",
		"vite": "^8.3.4",
		"vue-tsc": "^3.3.13"
	},
	"resolutions": {
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-model": "^1.25.12",
		"prosemirror-state": "^1.4.4",
		"prosemirror-transform": "^1.12.0",
		"prosemirror-view": "^1.42.2"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "yarn@1.22.22",
	"frappe": {
		"major": "16",
		"branch": "version-16"
	}
}
